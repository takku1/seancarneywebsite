---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import InquireLabel from '../components/ui/InquireLabel.astro';
import { creditsBy, rooms } from '../lib/content';
import { site } from '../config/site';
import { graph, breadcrumbSchema, personSchema } from '../lib/seo/schema';
import portrait from '../assets/photos/canyon-suit-laugh.jpg';
import hall from '../assets/photos/corporate-stage.jpg';

const roomList = await rooms();
const clients = await creditsBy('client');
const og = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const jsonLd = graph(breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }]), personSchema());
---

<BaseLayout pageType="about" image={og.src} imageAlt="Sean Carney in a dark suit with an acoustic guitar" title="About Sean Carney" description="Sean Carney leads a live-music house for luxury weddings and private events in Los Angeles and beyond: solo, duo or trio, and his full band, The Hustlers." type="profile" jsonLd={jsonLd}>
  <section class="intro" data-section="about_intro">
    <div class="container grid">
      <div>
        <h1>About</h1>
        <div class="prose">
          <p class="first">Sean Carney has played more than {site.stats.events.replace('+', '')} weddings and private events across {site.stats.years.replace('+', '')} years, from candlelit ceremonies to full dance floors.</p>
          <p>He leads a small house of musicians: alone with a guitar for the aisle and the dinner, as a duo or trio for cocktails, and with his band, The Hustlers, once the dancing starts. Couples book once, and the music follows the day.</p>
          <p>Planners know him for the details. The timeline is built with the venue, ceremony sound runs separately from the reception, must-play and do-not-play lists are honored, and a certificate of insurance is ready on request.</p>
          <p class="aside">Outside the wedding season, his music has been heard in the Paris Olympics coverage, the NFL Playoffs and on Netflix.</p>
        </div>
      </div>
      <div class="photo">
        <Image src={portrait} alt="Sean Carney smiling in a dark suit with an acoustic guitar" widths={[480, 800, 1200]} sizes="(min-width: 900px) 40vw, 92vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section places" data-section="about_rooms" aria-labelledby="rooms-title">
    <div class="container cols">
      <div>
        <h2 id="rooms-title">The rooms</h2>
        <ul class="names">{roomList.map((r) => <li><span>{r.data.name}</span>{r.data.detail && <small>{r.data.detail}</small>}</li>)}</ul>
        <p class="note">And private estates across Southern California, with celebrations in more than {site.stats.countries.replace('+', '')} countries.</p>
      </div>
      {clients.length > 0 && (
        <div>
          <h2>Hosted by</h2>
          <ul class="names">{clients.map((c) => <li><span>{c.data.name}</span></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <section class="band" data-section="about_band">
    <Image src={hall} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="bg" />
    <div class="container inner">
      <h2>On the dance floor, he is rarely alone.</h2>
      <p class="lede">The Hustlers scale from a trio to a full ensemble for receptions and galas.</p>
      <div class="acts">
        <a href="/inquire" class="btn" data-track="cta_click" data-track-location="about_band"><InquireLabel /></a>
        <a class="link-arrow" href="/weddings">How the day sounds <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 7rem); }
  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  h1 { font-size: var(--step-5); margin-bottom: 2rem; }
  .prose { display: grid; gap: 1.25rem; max-width: var(--measure); }
  .first { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3; }
  .prose p:not(.first) { color: var(--text-muted); }
  .aside { font-style: italic; }
  .photo :global(img) { width: 100%; height: auto; }

  .places { border-top: 1px solid var(--line); background: var(--bg-raised); }
  .cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 6rem); }
  .places h2 { font-size: var(--step-3); margin-bottom: 1.75rem; }
  .names { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .names li { display: flex; flex-direction: column; }
  .names span { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.15; }
  .names small { color: var(--text-muted); font-size: var(--step--1); }
  .note { margin-top: 1.75rem; color: var(--text-muted); max-width: 44ch; }

  .band {
    --text: var(--on-image);
    --text-muted: var(--on-image-muted);
    --line-strong: rgb(241 235 224 / 0.45);
    color: var(--text);
    position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(6rem, 12vw, 10rem);
  }
  .band :global(.bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 40%; }
  .band::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(9 8 7 / 0.88), rgb(9 8 7 / 0.4)); }
  .band h2 { font-size: var(--step-4); max-width: 16ch; }
  .band .lede { margin-block: 1.25rem 2rem; opacity: 0.9; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  @media (max-width: 899px) {
    .grid, .cols { grid-template-columns: minmax(0, 1fr); }
    .photo { max-width: 28rem; }
  }
</style>
