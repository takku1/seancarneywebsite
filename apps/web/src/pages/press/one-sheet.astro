---
/**
 * /press/one-sheet: the single-page summary bookers and festivals ask for.
 * Built from the same content as /press, printed or saved as PDF from the
 * browser (US Letter), so it is never out of date and never a 20MB file.
 * Paper-toned on screen and in print, whatever the site theme.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { bios } from '../../config/press';
import { creditsBy, featuredRelease, releaseHref } from '../../lib/content';
import photo from '../../assets/photos/hero-desert.jpg';

const [sync, broadcast, chart, venues, clients] = await Promise.all(['sync', 'broadcast', 'chart', 'venue', 'client'].map((c) => creditsBy(c as 'sync')));
const press = (await getCollection('press')).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)).slice(0, 2);
const r = await featuredRelease();
const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const host = site.url.replace(/^https?:\/\//, '');
const handles = site.socials.filter((s) => s.id === 'instagram' || s.id === 'youtube').map((s) => s.handle);
const uniqueHandles = [...new Set(handles)];
---

<BaseLayout bare pageType="one_sheet" title="One-sheet | Sean Carney" description="Sean Carney one-sheet: bio, credits, latest release, formats and booking contact on one page." noindex>
  <div class="tools">
    <a href="/press" class="back">Back to press kit</a>
    <button type="button" class="btn" data-print>Print or save as PDF</button>
  </div>

  <article class="sheet">
    <header class="head">
      <div>
        <h1>Sean Carney</h1>
        <p class="role">{site.role}. {site.home}.</p>
      </div>
      <dl class="contact">
        <div><dt>Bookings</dt><dd>{site.email.bookings}</dd></div>
        <div><dt>Web</dt><dd>{host}</dd></div>
        <div><dt>Social</dt><dd>{uniqueHandles.join(' · ')}</dd></div>
      </dl>
    </header>

    <div class="hero">
      <Image src={photo} alt="Sean Carney in a black hat and embroidered shirt against desert hills" widths={[800, 1400]} sizes="8in" loading="eager" />
    </div>

    <div class="body">
      <section class="bio">
        <h2>Biography</h2>
        <p>{bios.medium}</p>
        <p class="stats">{site.stats.years} years performing. {site.stats.events} events. {site.stats.countries} countries.</p>
      </section>

      <aside class="side">
        <section>
          <h2>Heard on</h2>
          <p>{[...sync, ...broadcast].map((c) => c.data.name).join(', ')}.</p>
        </section>
        <section>
          <h2>Recognition</h2>
          <p>{chart.map((c) => `${c.data.name}${c.data.detail ? ` (${c.data.detail.toLowerCase()})` : ''}`).join(', ')}.</p>
        </section>
        <section class="latest">
          <h2>Latest release</h2>
          <div class="rel">
            <Image src={r.data.cover} alt="" width={120} height={120} />
            <p><strong>{r.data.title}</strong>{r.data.date && ` (${r.data.date.getUTCFullYear()})`}<br />{r.data.artists}</p>
          </div>
          <p class="url">{host}{releaseHref(r.id)}</p>
        </section>
      </aside>
    </div>

    <div class="row3">
      <section>
        <h2>Stages and rooms</h2>
        <p>{venues.map((c) => c.data.name).join(', ')}.</p>
      </section>
      <section>
        <h2>Clients</h2>
        <p>{clients.map((c) => c.data.name).join(', ')}.</p>
      </section>
      <section>
        <h2>Formats</h2>
        <p>Solo acoustic, duo or trio, or the full band, Sean Carney and The Hustlers. Los Angeles based, travels worldwide.</p>
      </section>
    </div>

    {press.length > 0 && (
      <div class="quotes">
        {press.map((p) => <blockquote>&ldquo;{p.data.quote}&rdquo;<cite>{p.data.outlet}</cite></blockquote>)}
      </div>
    )}

    <footer class="foot">
      <span>Bookings and press: {site.email.bookings}</span>
      <span>{host}/press · Updated {updated}</span>
    </footer>
  </article>
</BaseLayout>

<script>
  import { track } from '../../lib/analytics/track';
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    track('one_sheet_print', {});
    window.print();
  });
</script>

<style>
  /* Paper palette, local to the sheet: identical on screen and in print. */
  .sheet {
    --bg: #fbf9f5; --text: #24201b; --text-muted: #5f574d; --line: rgb(36 32 27 / 0.16); --accent: #8c6a42;
    width: min(8.5in, 100% - 2 * var(--gutter));
    margin: 0 auto 4rem;
    padding: 0.6in;
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.45);
    font-size: 10.5pt;
    line-height: 1.45;
  }
  .tools { display: flex; justify-content: space-between; align-items: center; gap: 1rem; width: min(8.5in, 100% - 2 * var(--gutter)); margin: 2rem auto 1.5rem; }
  .back { color: var(--text-muted); font-size: var(--step--1); text-underline-offset: 0.2em; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1.5rem; padding-bottom: 0.18in; border-bottom: 1px solid var(--line); }
  h1 { font-size: 34pt; line-height: 0.95; letter-spacing: -0.01em; }
  .role { color: var(--text-muted); margin-top: 0.4rem; }
  .contact { margin: 0; display: grid; gap: 0.1rem; font-size: 8.5pt; }
  .contact div { display: flex; gap: 0.6rem; }
  .contact dt { color: var(--text-muted); min-width: 4.5em; }
  .contact dd { margin: 0; }
  .hero { margin-top: 0.2in; }
  .hero :global(img) { display: block; width: 100%; height: 2.25in; object-fit: cover; object-position: center 30%; }
  h2 { font-family: var(--font-body); font-size: 8pt; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.35rem; }
  .body { display: grid; grid-template-columns: 1.35fr 1fr; gap: 0.3in; margin-top: 0.2in; }
  .bio p { font-family: var(--font-display); font-size: 12.5pt; line-height: 1.4; }
  .bio .stats { margin-top: 0.6rem; font-family: var(--font-body); font-size: 9.5pt; color: var(--text-muted); }
  .side { display: grid; gap: 0.18in; align-content: start; font-size: 9.5pt; }
  .rel { display: flex; gap: 0.6rem; align-items: center; }
  .rel :global(img) { width: 0.7in; height: 0.7in; object-fit: cover; }
  .url { margin-top: 0.3rem; font-size: 8.5pt; color: var(--text-muted); overflow-wrap: anywhere; }
  .rel strong { font-family: var(--font-display); font-size: 12pt; font-weight: 600; }
  .row3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.3in; margin-top: 0.2in; padding-top: 0.16in; border-top: 1px solid var(--line); font-size: 9.5pt; }
  .quotes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.3in; margin-top: 0.2in; padding-top: 0.16in; border-top: 1px solid var(--line); }
  blockquote { margin: 0; font-family: var(--font-display); font-size: 12pt; line-height: 1.3; }
  cite { display: block; margin-top: 0.3rem; font-family: var(--font-body); font-style: normal; font-size: 8.5pt; color: var(--text-muted); }
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.2in; padding-top: 0.15in; border-top: 1px solid var(--line); font-size: 8.5pt; color: var(--text-muted); }

  @media (max-width: 700px) {
    .sheet { padding: 1.25rem; }
    .head { grid-template-columns: minmax(0, 1fr); }
    .body, .row3, .quotes { grid-template-columns: minmax(0, 1fr); }
  }

  @media print {
    @page { size: letter; margin: 0; }
    :global(html), :global(body) { background: #fbf9f5 !important; }
    :global(body::after), :global(.skip), :global([data-consent]), .tools { display: none !important; }
    .sheet { width: 8.5in; height: 11in; overflow: hidden; margin: 0; box-shadow: none; padding: 0.42in 0.5in; }
    .body, .row3, .quotes, .head { break-inside: avoid; }
    :global(*) { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
