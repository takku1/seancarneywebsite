---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SpotifyFacade from '../components/media/SpotifyFacade.astro';
import YouTubeFacade from '../components/media/YouTubeFacade.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';
import ScoutInvite from '../components/scout/ScoutInvite.astro';
import Rail from '../components/ui/Rail.astro';
import FollowLinks from '../components/ui/FollowLinks.astro';
import { graph, breadcrumbSchema, albumSchema } from '../lib/seo/schema';
import { releaseHref } from '../lib/content';
import { loadMedia, newest, mostWatched, viewsLabel, type Video } from '../lib/feeds/media';

const releases = (await getCollection('releases')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
// Media pipeline: newest and most-watched come from YouTube when connected,
// otherwise from the curated order. Sections never repeat a clip.
const media = await loadMedia();
const seen = new Set<string>();
const take = (list: Video[], n: number) => list.filter((v) => !seen.has(v.youtubeId) && seen.add(v.youtubeId)).slice(0, n);
const groups = [
  { id: 'newest', title: 'Newest', list: media.sources.youtube ? take(newest(media), 6) : [] },
  { id: 'most_watched', title: 'Most watched', list: media.sources.youtube ? take(mostWatched(media), 6) : [] },
  { id: 'live', title: 'Live at events', list: take(media.videos.filter((v) => v.context === 'live' || v.context === 'session').sort((a, b) => b.scores.event - a.scores.event), 12) },
  { id: 'originals', title: 'Originals', list: take(media.videos.filter((v) => v.context === 'original').sort((a, b) => b.scores.best - a.scores.best), 12) },
  { id: 'covers', title: 'Covers, as requested at events', list: take(media.videos.filter((v) => v.context === 'cover').sort((a, b) => b.scores.best - a.scores.best), 12) },
].filter((g) => g.list.length > 0);
const meta = (v: Video) => [v.note, viewsLabel(v)].filter(Boolean).join(', ');

// Spotify releases newer than anything curated appear automatically (e.g. a new single).
const norm = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');
const curatedTitles = new Set(releases.map((r) => norm(r.data.title)));
const autoReleases = media.releases.filter((r) => !curatedTitles.has(norm(r.title))).slice(0, 6);
const topTracks = media.topTracks.slice(0, 5);

const jsonLd = graph(
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Music', path: '/music' }]),
  ...releases.map((r) => albumSchema({ title: r.data.title, kind: r.data.kind, date: r.data.date, url: `${site.url}${releaseHref(r.id)}`, sameAs: r.data.links.map((l) => l.url) })),
);
---

<BaseLayout pageType="music" title="Music | Sean Carney" description="Albums, singles and videos from Sean Carney, including California Cowboy, WANTED, Graveyard with Kirsten Collins, and Do Or Die from the 2025 NFL Playoffs." jsonLd={jsonLd}>
  <PageHeader title="Music" intro="Rock, Americana and cinematic songwriting. Rugged western atmosphere with a stadium-sized chorus.">
    <div class="scout-in"><ScoutInvite variant="inline" source="music" text="Not sure where to start? Tell Scout what you're into." prompts={['Something for a long drive', 'Best live clips']} /></div>
  </PageHeader>

  <section class="section releases" data-section="discography" aria-labelledby="disco-title">
    <div class="container">
      <h2 id="disco-title" class="visually-hidden">Discography</h2>
      <ul>
        {releases.map((r, i) => (
          <li class:list={['reveal', { lead: i === 0 }]} data-published={r.data.date?.toISOString()}>
            <a class="cover-link" href={releaseHref(r.id)} tabindex="-1" aria-hidden="true" data-track="release_card_click" data-track-release={r.id} data-track-location="music_page">
              <Image src={r.data.cover} alt="" widths={[360, 640, 960]} sizes={i === 0 ? '(min-width: 900px) 40vw, 92vw' : '(min-width: 900px) 22vw, 92vw'} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
            </a>
            <div class="info">
              <h3><a href={releaseHref(r.id)} data-track="release_card_click" data-track-release={r.id} data-track-location="music_page">{r.data.title}</a><span data-new-slot></span></h3>
              <p class="meta">{r.data.artists}{r.data.date && `, ${r.data.date.getUTCFullYear()}`}</p>
              <p class="hook">{r.data.story ?? r.data.hook}</p>
              {r.data.spotify && <div class="sp"><SpotifyFacade uri={r.data.spotify} title={r.data.title} location="music_page" /></div>}
              <ul class="links">
                {r.data.links.filter((l) => !(r.data.spotify && l.label === 'Spotify')).map((l) => (
                  <li><a class="link-arrow" href={l.url} target="_blank" rel="noopener" data-track="release_link_click" data-track-release={r.id} data-track-label={l.label}>{l.label} <Icon name="arrow-up-right" /></a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {(autoReleases.length > 0 || topTracks.length > 0) && (
    <section class="section spotify" data-section="spotify_auto" aria-label="More on Spotify">
      <div class="container sp-cols">
        {autoReleases.length > 0 && (
          <div>
            <h2 class="sp-h">More releases</h2>
            <ul class="mini">
              {autoReleases.map((r) => (
                <li>
                  <a href={r.url} target="_blank" rel="noopener" data-track="release_link_click" data-track-release={r.spotifyId} data-track-label="spotify_auto">
                    {r.cover && <Image src={r.cover} alt="" width={120} height={120} />}
                    <span><strong>{r.title}</strong><small>{r.kind === 'single' ? 'Single' : 'Album'}, {r.date.getUTCFullYear()}</small></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {topTracks.length > 0 && (
          <div>
            <h2 class="sp-h">Most played on Spotify</h2>
            <ol class="mini">
              {topTracks.map((t) => (
                <li>
                  <a href={t.url} target="_blank" rel="noopener" data-track="top_track_click" data-track-track={t.title}>
                    {t.cover && <Image src={t.cover} alt="" width={120} height={120} />}
                    <span><strong>{t.title}</strong><small>{t.album}</small></span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section film" id="film" data-section="videos" aria-labelledby="film-title">
    <div class="container">
      <h2 id="film-title">Videos</h2>
      {groups.map((g) => (
        <Rail title={g.title} id={g.id}>
          {g.list.map((v) => (
            <figure data-published={v.published?.toISOString()}>
              <YouTubeFacade id={v.youtubeId} title={v.title} location={`music_${g.id}`} />
              <figcaption><span class="t">{v.title}<span data-new-slot></span></span>{meta(v) && <span class="n">{meta(v)}</span>}</figcaption>
            </figure>
          ))}
        </Rail>
      ))}
    </div>
  </section>

  <section class="section fan" data-section="fan_links" aria-labelledby="fan-title">
    <div class="container fan-row">
      <h2 id="fan-title">Follow and support</h2>
      <div class="fan-follow"><FollowLinks location="music_page" /></div>
      <ul>
        {site.socials.map((s) => (
          <li><a class="link-arrow" href={s.url} target="_blank" rel="me noopener" data-track="social_click" data-track-network={s.id} data-track-location="music">{s.label} <Icon name="arrow-up-right" /></a></li>
        ))}
        <li><a class="link-arrow" href="/merch" data-track="merch_click">Merch <Icon name="arrow-right" /></a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .releases ul { list-style: none; margin: 0; padding: 0; }
  .releases > .container > ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 4rem) 2rem; }
  .releases li.lead { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .releases :global(img) { width: 100%; height: auto; }
  .info { margin-top: 1.25rem; }
  .lead .info { margin-top: 0; }
  h3 { font-size: var(--step-2); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .cover-link { display: block; }
  .cover-link :global(img) { transition: opacity 0.3s var(--ease-out); }
  .cover-link:hover :global(img) { opacity: 0.88; }
  .lead h3 { font-size: var(--step-5); }
  .meta { color: var(--text-muted); font-size: var(--step--1); margin-top: 0.35rem; }
  .hook { margin-top: 0.75rem; color: var(--text-muted); }
  .lead .hook { font-size: var(--step-1); }
  .sp { margin-top: 1.25rem; max-width: 34rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin-top: 0.75rem !important; }

  .scout-in { margin-top: 2rem; max-width: 46rem; }
  .film { background: var(--bg-sunk); }
  .sp-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); }
  .sp-h { font-size: var(--step-3); margin-bottom: 1.5rem; }
  .mini { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .mini a { display: flex; align-items: center; gap: 1rem; text-decoration: none; min-height: 60px; }
  .mini :global(img) { width: 60px; height: 60px; object-fit: cover; flex: none; }
  .mini strong { display: block; font-family: var(--font-display); font-size: var(--step-1); font-weight: 500; }
  .mini small { color: var(--text-muted); font-size: var(--step--1); }
  .mini a:hover strong { color: var(--accent); }
  @media (max-width: 899px) { .sp-cols { grid-template-columns: minmax(0, 1fr); } }
  .film h2 { font-size: var(--step-4); margin-bottom: 2rem; }
  .group { font-family: var(--font-body); font-size: var(--step--1); font-weight: 500; color: var(--text-muted); margin: 2.5rem 0 1.25rem; }
  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1.5rem; }
  figure { margin: 0; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; margin-top: 0.75rem; }
  .t { font-family: var(--font-display); font-size: var(--step-1); }
  .n { font-size: var(--step--1); color: var(--text-muted); }

  .fan-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; align-items: center; }
  .fan h2 { font-size: var(--step-3); }
  .fan-follow { flex: 1 1 100%; max-width: 44rem; }
  .fan ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }

  @media (max-width: 899px) {
    .releases > .container > ul { grid-template-columns: minmax(0, 1fr); }
    .releases li.lead { grid-template-columns: minmax(0, 1fr); }
  }
</style>
