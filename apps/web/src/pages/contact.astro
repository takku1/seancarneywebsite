---
/** Contact routes: couples, planners and venues, and everything else. Each route tags the lead source. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import InquireLabel from '../components/ui/InquireLabel.astro';
import { site } from '../config/site';
import { graph, breadcrumbSchema } from '../lib/seo/schema';

const routes = [
  { title: 'Weddings and private events', body: 'Ceremonies, receptions, company evenings, galas, estates and destination dates.', cta: 'inquire' as const },
  { title: 'Planners and venues', body: 'Insurance certificates, riders, stage plots and timelines. The planner toolkit has the essentials.', email: site.email.bookings, subject: 'Planner or venue inquiry', track: 'planner', page: '/planners' },
  { title: 'Everything else', body: 'Press, partnerships and general questions.', email: site.email.management, subject: 'General inquiry', track: 'general' },
];
const jsonLd = graph(breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }]));
---

<BaseLayout pageType="contact" title="Contact | Sean Carney" description="Contact Sean Carney for weddings and private events, planner and venue requests, and general questions." jsonLd={jsonLd}>
  <PageHeader title="Contact" intro={`Sean replies personally, ${site.responseTime}.`} />
  <section class="section" data-section="contact_routes">
    <div class="container">
      <ul class="routes">
        {routes.map((r) => (
          <li>
            <h2>{r.title}</h2>
            <p>{r.body}</p>
            {r.cta === 'inquire' ? (
              <a href="/inquire" class="btn" data-track="cta_click" data-track-location="contact"><InquireLabel /></a>
            ) : (
              <>
                <a class="link-arrow" href={`mailto:${r.email}?subject=${encodeURIComponent(r.subject!)}`} data-track="contact_route_click" data-track-route={r.track}>
                  <Icon name="envelope" /> {r.email}
                </a>
                {r.page && <a class="link-arrow toolkit" href={r.page} data-track="contact_route_click" data-track-route="planner_toolkit">The planner toolkit <Icon name="arrow-right" /></a>}
              </>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .routes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line-strong); }
  .routes li { padding: clamp(1.75rem, 4vw, 3rem) clamp(0rem, 3vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0; border-bottom: 1px solid var(--line); }
  .routes li:nth-child(odd) { border-right: 1px solid var(--line); }
  .routes li:nth-child(even) { padding-left: clamp(1.5rem, 3vw, 3rem); }
  h2 { font-size: var(--step-3); margin-bottom: 0.75rem; }
  p { color: var(--text-muted); margin-bottom: 1.5rem; max-width: 40ch; }
  @media (max-width: 767px) {
    .routes { grid-template-columns: minmax(0, 1fr); }
    .routes li:nth-child(n) { border-right: 0; padding-left: 0; }
  }
  .toolkit { margin-left: 1.5rem; }
</style>
