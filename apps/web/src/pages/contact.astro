---
/** Management and Bookings: separate routes signal a team and tag the lead source. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Icon from '../components/ui/Icon.astro';
import InquireLabel from '../components/ui/InquireLabel.astro';
import { site } from '../config/site';
import { graph, breadcrumbSchema } from '../lib/seo/schema';

const routes = [
  { title: 'Private events and corporate', body: 'Weddings, galas, company events, estates and destination dates.', cta: 'inquire' as const },
  { title: 'Press and media', body: 'Interviews, features, premieres and photo requests.', email: site.email.press, subject: 'Press inquiry', track: 'press' },
  { title: 'Sync and licensing', body: 'Film, television, advertising and trailer placements.', email: site.email.licensing, subject: 'Licensing inquiry', track: 'licensing' },
  { title: 'Management', body: 'Partnerships, endorsements and everything else.', email: site.email.management, subject: 'Management inquiry', track: 'management' },
];
const jsonLd = graph(breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }]));
---

<BaseLayout pageType="contact" title="Management and Bookings | Sean Carney" description="Contact Sean Carney's team for private events, press, sync licensing and management." jsonLd={jsonLd}>
  <PageHeader title="Management and bookings" />
  <section class="section" data-section="contact_routes">
    <div class="container">
      <ul class="routes">
        {routes.map((r) => (
          <li>
            <h2>{r.title}</h2>
            <p>{r.body}</p>
            {r.cta === 'inquire' ? (
              <a href="/inquire" class="btn" data-track="cta_click" data-track-location="contact"><InquireLabel /></a>
            ) : (
              <a class="link-arrow" href={`mailto:${r.email}?subject=${encodeURIComponent(r.subject!)}`} data-track="contact_route_click" data-track-route={r.track}>
                <Icon name="envelope" /> {r.email}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .routes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line-strong); }
  .routes li { padding: clamp(1.75rem, 4vw, 3rem) clamp(0rem, 3vw, 3rem) clamp(1.75rem, 4vw, 3rem) 0; border-bottom: 1px solid var(--line); }
  .routes li:nth-child(odd) { border-right: 1px solid var(--line); }
  .routes li:nth-child(even) { padding-left: clamp(1.5rem, 3vw, 3rem); }
  h2 { font-size: var(--step-3); margin-bottom: 0.75rem; }
  p { color: var(--text-muted); margin-bottom: 1.5rem; max-width: 40ch; }
  @media (max-width: 767px) {
    .routes { grid-template-columns: minmax(0, 1fr); }
    .routes li:nth-child(n) { border-right: 0; padding-left: 0; }
  }
</style>
