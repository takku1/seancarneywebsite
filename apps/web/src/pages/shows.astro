---
/**
 * /shows (was /appearances). Public dates with ticket links when they exist;
 * until then a "dates coming soon" moment with a notify list that also tells
 * Sean which cities want him. Notable stages below for credibility.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import NotifyForm from '../components/ui/NotifyForm.astro';
import ScoutInvite from '../components/scout/ScoutInvite.astro';
import { appearancesSplit, creditsBy, fmtDay } from '../lib/content';
import { graph, breadcrumbSchema, eventSchema } from '../lib/seo/schema';
import bg from '../assets/photos/live-bandshell-2.jpg';

const { upcoming, recent } = await appearancesSplit();
const og = await getImage({ src: bg, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const venues = await creditsBy('venue');
const publicUpcoming = upcoming.filter((a) => a.data.visibility === 'public' && a.data.kind !== 'private');

const jsonLd = graph(
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Shows', path: '/shows' }]),
  ...publicUpcoming.map((a) => eventSchema({ title: a.data.title, date: a.data.date, venue: a.data.venue, city: a.data.city, url: a.data.url })),
);
---

<BaseLayout pageType="shows" overlayHeader image={og.src} imageAlt="Sean Carney performing on stage" title="Shows and Tickets | Sean Carney" description="Upcoming Sean Carney shows and tickets. Get notified when new dates are announced, and see the stages he has played, from the Troubadour to Crypto.com Arena." jsonLd={jsonLd}>
  <section class="hero" data-section="shows_hero">
    <Image src={bg} alt="" widths={[768, 1280, 2048]} sizes="100vw" class="bg" loading="eager" fetchpriority="high" />
    <div class="shade"></div>
    <div class="container inner">
      <h1>Shows</h1>
      {publicUpcoming.length > 0 ? (
        <p class="lede">Public dates and tickets. Private events are never listed.</p>
      ) : (
        <>
          <p class="lede">New dates are on the way. Be the first to hear when tickets go on sale, and tell us where you'd like Sean to play.</p>
          <NotifyForm topic="shows" askCity cta="Notify me" />
        </>
      )}
    </div>
  </section>

  {publicUpcoming.length > 0 && (
    <section class="section" data-section="upcoming" aria-labelledby="up-title">
      <div class="container">
        <h2 id="up-title" class="visually-hidden">Upcoming shows</h2>
        <ol class="dates">
          {publicUpcoming.map((a) => (
            <li>
              <time datetime={a.data.date.toISOString()}>{fmtDay(a.data.date)}</time>
              <span class="v">{a.data.venue}</span>
              <span class="c">{a.data.city}</span>
              {a.data.url ? (
                <a class="btn" href={a.data.url} target="_blank" rel="noopener" data-track="ticket_click" data-track-venue={a.data.venue}>Get tickets <Icon name="arrow-up-right" /></a>
              ) : (
                <span class="c">Tickets soon</span>
              )}
            </li>
          ))}
        </ol>
        <div class="notify-after"><p>Want the next announcement?</p><NotifyForm topic="shows" askCity location="shows_after_list" /></div>
      </div>
    </section>
  )}

  {recent.length > 0 && (
    <section class="section" data-section="recent" aria-labelledby="recent-title">
      <div class="container">
        <h2 id="recent-title">Recent</h2>
        <ol class="dates">
          {recent.map((a) => (
            <li>
              <time datetime={a.data.date.toISOString()}>{fmtDay(a.data.date)}</time>
              <span class="v">{a.data.visibility === 'anonymized' ? 'Private event' : a.data.venue}</span>
              <span class="c">{a.data.city}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="section stages" data-section="notable_stages" aria-labelledby="stages-title">
    <div class="container">
      <h2 id="stages-title">Stages he's played</h2>
      <ul class="big">
        {venues.map((v) => <li><span>{v.data.name}</span>{v.data.detail && <small>{v.data.detail}</small>}</li>)}
      </ul>
    </div>
  </section>

  <div class="container scout-row">
    <ScoutInvite source="shows" text="Want Sean at your own event instead? Scout can check a date." prompts={['Check a date']} />
  </div>
</BaseLayout>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: min(78vh, 760px); display: flex; align-items: flex-end; padding-block: calc(var(--header-h) + 3rem) clamp(3rem, 7vw, 5rem); }
  .hero :global(.bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 35%; }
  .shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(9 8 7 / 0.95), rgb(9 8 7 / 0.55) 55%, rgb(9 8 7 / 0.3)); }
  .inner { color: var(--on-image); }
  h1 { font-size: var(--step-5); }
  .lede { margin-block: 1.25rem 2rem; color: var(--on-image); opacity: 0.88; max-width: 44ch; }
  @media (prefers-reduced-motion: no-preference) {
    h1, .lede, .inner :global(.notify) { animation: enter 0.8s var(--ease-out) both; }
    .lede { animation-delay: 0.15s; }
    .inner :global(.notify) { animation-delay: 0.3s; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(16px); } }

  h2 { font-size: var(--step-4); margin-bottom: 2rem; }
  .dates { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .dates li { display: grid; grid-template-columns: 14rem minmax(0, 1fr) 12rem auto; gap: 1.5rem; align-items: center; padding-block: 1.25rem; border-bottom: 1px solid var(--line); }
  time, .c { color: var(--text-muted); font-size: var(--step--1); }
  .v { font-family: var(--font-display); font-size: var(--step-2); }
  .notify-after { margin-top: 3rem; padding: 2rem; background: var(--bg-sunk); }
  .notify-after p { font-family: var(--font-display); font-size: var(--step-2); margin-bottom: 1rem; }
  .notify-after :global(label), .notify-after :global(.fine) { color: var(--text-muted); }
  .notify-after :global(input) { background: var(--bg); color: var(--text); border-color: var(--line-strong); }
  .stages { border-top: 1px solid var(--line); }
  .big { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 1.5rem 3rem; }
  .big li { display: flex; flex-direction: column; }
  .big span { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.15; }
  .big small { color: var(--text-muted); font-size: var(--step--1); }
  .scout-row { padding-bottom: var(--space-section); }
  @media (max-width: 899px) { .dates li { grid-template-columns: minmax(0, 1fr); gap: 0.35rem; } }
</style>
