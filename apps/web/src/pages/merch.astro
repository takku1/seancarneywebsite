---
/** /merch: official store coming soon, with a notify list. */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NotifyForm from '../components/ui/NotifyForm.astro';
import Icon from '../components/ui/Icon.astro';
import bg from '../assets/photos/graffiti-tunnel.jpg';
import { graph, breadcrumbSchema } from '../lib/seo/schema';

const og = await getImage({ src: bg, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
---

<BaseLayout
  pageType="merch"
  image={og.src}
  imageAlt="Sean Carney in a graffiti tunnel"
  title="Merch | Sean Carney"
  description="Official Sean Carney merch is coming soon. Join the list to be first when it drops."
  jsonLd={graph(breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Merch', path: '/merch' }]))}
>
  <section class="hero" data-section="merch_hero">
    <Image src={bg} alt="" widths={[768, 1280, 2048]} sizes="100vw" class="bg" loading="eager" fetchpriority="high" />
    <div class="shade"></div>
    <div class="container inner">
      <p class="label tag">Coming soon</p>
      <h1>Merch, made for outlaws.</h1>
      <p class="lede">The official store is in the works. Join the list and you'll be first in line when the first run drops.</p>
      <NotifyForm topic="merch" cta="Get first access" />
      <p class="more"><a class="link-arrow" href="/music">Listen while you wait <Icon name="arrow-right" /></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: calc(100dvh - var(--header-h)); display: flex; align-items: center; padding-block: 4rem; }
  .hero :global(.bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 60% 40%; filter: grayscale(0.35); }
  .shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(9 8 7 / 0.94) 0%, rgb(9 8 7 / 0.75) 45%, rgb(9 8 7 / 0.35) 100%); }
  .inner { color: var(--on-image); }
  .tag { color: var(--accent); margin-bottom: 1rem; }
  h1 { font-size: var(--step-5); max-width: 12ch; }
  .lede { margin-block: 1.25rem 2rem; color: var(--on-image); opacity: 0.88; max-width: 42ch; }
  .more { margin-top: 2rem; }
  .more :global(.link-arrow) { color: var(--on-image); }
  @media (prefers-reduced-motion: no-preference) {
    .tag, h1, .lede, .inner :global(.notify), .more { animation: enter 0.8s var(--ease-out) both; }
    h1 { animation-delay: 0.1s; }
    .lede { animation-delay: 0.25s; }
    .inner :global(.notify) { animation-delay: 0.4s; }
    .more { animation-delay: 0.5s; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(16px); } }
  @media (max-width: 767px) { .shade { background: rgb(9 8 7 / 0.82); } }
</style>
