---
/**
 * /links: the link-in-bio page (replaces Linktree). Instagram and TikTok bios
 * point here, so every tap lands on our domain: first-touch attribution is
 * captured, each link is measured (links_click), and fans can join the list
 * without leaving. Recommended bio URL:
 *   seancarneymusic.com/links?utm_source=instagram&utm_medium=social&utm_campaign=bio
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NotifyForm from '../components/ui/NotifyForm.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import { site } from '../config/site';
import { featuredRelease, releaseHref } from '../lib/content';
import portrait from '../assets/photos/canyon-suit-portrait.jpg';

const r = await featuredRelease();
const kind = { album: 'New album', single: 'New single', ep: 'New EP', feature: 'New feature' }[r.data.kind];
const yt = site.socials.find((s) => s.id === 'youtube');
const sp = site.socials.find((s) => s.id === 'spotify');

const links = [
  { id: 'book', href: '/private-events', title: 'Book Sean for your event', sub: 'Weddings, galas, brands and private estates' },
  ...(sp ? [{ id: 'spotify', href: site.follow.spotify, title: 'Follow on Spotify', sub: 'New releases land in your Release Radar', icon: 'spotify' as IconName, external: true }] : []),
  ...(yt ? [{ id: 'youtube', href: site.follow.youtube, title: 'Subscribe on YouTube', sub: 'Live sessions, originals and covers', icon: 'youtube' as IconName, external: true }] : []),
  { id: 'shows', href: '/shows', title: 'Shows', sub: 'Public dates and where to hear him next' },
  { id: 'merch', href: '/merch', title: 'Merch', sub: 'The official store' },
  { id: 'press', href: '/press', title: 'Press kit', sub: 'Bios, credits and photos' },
];
---

<BaseLayout bare pageType="links" title="Sean Carney | Links" description="Sean Carney's latest music, videos, shows, merch and event bookings in one place." noindex>
  <div class="wrap">
    <header class="top">
      <Image src={portrait} alt="Sean Carney in a dark suit with an acoustic guitar in a canyon" widths={[480, 800]} sizes="(min-width: 560px) 34rem, 100vw" loading="eager" fetchpriority="high" class="photo" />
      <div class="id">
        <h1>Sean Carney</h1>
        <p>{site.role}. Heard on the Paris Olympics, the NFL Playoffs and Netflix.</p>
      </div>
    </header>

    <nav aria-label="Links" class="list">
      <a class="release" href={releaseHref(r.id)} data-track="links_click" data-track-link="featured_release" data-track-release={r.id}>
        <Image src={r.data.cover} alt="" width={160} height={160} />
        <span class="txt">
          <span class="t">{r.data.title}</span>
          <span class="s">{kind}. Every way to listen</span>
        </span>
        <Icon name="arrow-right" />
      </a>
      {links.map((l) => (
        <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} data-track="links_click" data-track-link={l.id}>
          <span class="txt">
            <span class="t">{l.icon && <Icon name={l.icon} />}{l.title}</span>
            <span class="s">{l.sub}</span>
          </span>
          <Icon name={l.external ? 'arrow-up-right' : 'arrow-right'} />
        </a>
      ))}
    </nav>

    <section class="join" aria-labelledby="links-join">
      <h2 id="links-join">Get new music first</h2>
      <NotifyForm topic="news" tone="surface" cta="Join" location="links" />
    </section>

    <footer class="foot">
      <ul class="socials" aria-label="Social">
        {site.socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="me noopener" data-track="social_click" data-track-network={s.id} data-track-location="links"><Icon name={s.id as IconName} label={s.label} /></a></li>
        ))}
      </ul>
      <a class="home" href="/">seancarneymusic.com</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .wrap { width: min(34rem, 100%); margin-inline: auto; padding-bottom: 3rem; }
  .top { position: relative; }
  .top :global(.photo) { display: block; width: 100%; height: min(62svh, 34rem); object-fit: cover; object-position: center 25%; }
  .top::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--bg) 2%, rgb(var(--scrim) / 0.35) 45%, transparent 75%); pointer-events: none; }
  .id { position: absolute; z-index: 1; left: var(--gutter); right: var(--gutter); bottom: 1.25rem; color: var(--on-image); }
  h1 { font-size: var(--step-4); line-height: 0.95; letter-spacing: -0.02em; }
  .id p { margin-top: 0.6rem; color: var(--on-image-muted); font-size: var(--step--1); max-width: 34ch; }

  .list { display: grid; gap: 0.6rem; padding: 1.25rem var(--gutter) 0; }
  .list a {
    display: flex; align-items: center; gap: 1rem; min-height: 72px; padding: 0.75rem 1.1rem;
    border: 1px solid var(--line-strong); text-decoration: none; background: var(--bg-raised);
    transition: border-color 0.25s var(--ease-out), background-color 0.25s var(--ease-out);
  }
  .list a:hover { border-color: var(--accent); }
  .list a:active { background: var(--bg-sunk); }
  .list a > :global(svg) { flex: none; width: 18px; height: 18px; color: var(--text-muted); margin-left: auto; }
  .list a:hover > :global(svg) { color: var(--accent); }
  .txt { display: grid; gap: 0.15rem; min-width: 0; }
  .t { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.15; }
  .t :global(svg) { width: 20px; height: 20px; color: var(--text-muted); }
  .s { color: var(--text-muted); font-size: var(--step--1); }
  .release { border-color: var(--accent) !important; padding: 0.6rem !important; }
  .release :global(img) { width: 72px; height: 72px; object-fit: cover; flex: none; }

  .join { margin: 2.5rem var(--gutter) 0; padding-top: 2rem; border-top: 1px solid var(--line); }
  .join h2 { font-size: var(--step-2); margin-bottom: 1rem; }

  .foot { display: grid; justify-items: center; gap: 1rem; margin-top: 2.5rem; padding-inline: var(--gutter); }
  .socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; }
  .socials a { display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; color: var(--text-muted); }
  .socials a:hover { color: var(--accent); }
  .socials :global(svg) { width: 22px; height: 22px; }
  .home { color: var(--text-muted); font-size: var(--step--1); text-underline-offset: 0.2em; }
</style>
