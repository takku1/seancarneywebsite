---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Rooms from '../components/home/Rooms.astro';
import DayArc from '../components/home/DayArc.astro';
import Formats from '../components/home/Formats.astro';
import SuppliedFilm from '../components/home/SuppliedFilm.astro';
import StickyListen from '../components/media/StickyListen.astro';
import MeetSean from '../components/home/MeetSean.astro';
import PlayersPreview from '../components/home/PlayersPreview.astro';
import CustomSongTeaser from '../components/home/CustomSongTeaser.astro';
import Testimonials from '../components/home/Testimonials.astro';
import EventsBand from '../components/home/EventsBand.astro';
import ScoutInvite from '../components/scout/ScoutInvite.astro';
import { graph, personSchema, websiteSchema, serviceSchema } from '../lib/seo/schema';
const jsonLd = graph(personSchema(), websiteSchema(), serviceSchema());
---

<BaseLayout
  pageType="home"
  overlayHeader
  title="Luxury Wedding Entertainment | SCE"
  description="Sean Carney Entertainment: luxury live music for weddings, private celebrations and corporate events. Solo, duo and band with The SCENE, and custom written songs."
  jsonLd={jsonLd}
>
  <Hero />
  <Rooms />
  <MeetSean />
  <Formats />
  <DayArc />
  <CustomSongTeaser />
  <PlayersPreview />
  <SuppliedFilm />
  <Testimonials ids={['jordan-isabela', 'timea-kris', 'olivia-john']} />
  <div class="container scout-row"><ScoutInvite source="home" text="Have a date in mind? Scout, Sean's AI assistant, can check it and answer questions in a minute." prompts={['Check a date', 'Which format suits our day?']} /></div>
  <EventsBand />
  <StickyListen location="home" />
</BaseLayout>

<style>
  .scout-row { padding-block: 0 var(--space-section); }
</style>
