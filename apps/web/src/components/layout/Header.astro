---
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';
import InquireLabel from '../ui/InquireLabel.astro';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const events = (await getCollection('events')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const primary = [
  { href: '/music', label: 'Music' },
  { href: '/shows', label: 'Shows' },
  { href: '/merch', label: 'Merch' },
  { href: '/press', label: 'Press' },
  { href: '/about', label: 'About' },
];
const norm = path.replace(/\/$/, '') || '/';
const onEvent = (slug: string) => norm === `/${slug}`;
// "page" = this exact page; "true" = the section you're in (an event page under Private Events).
const eventsCurrent = norm === '/private-events' ? 'page' : events.some((e) => onEvent(e.data.slug)) ? 'true' : undefined;
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="container bar">
    <a href="/" class="wordmark" aria-label="Sean Carney, home">Sean Carney</a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {primary.slice(0, 2).map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li class="has-menu">
          <a href="/private-events" aria-current={eventsCurrent}>Private Events</a>
          <div class="menu">
            <ul>
              {events.map((e) => (
                <li><a href={`/${e.data.slug}`} aria-current={onEvent(e.data.slug) ? 'page' : undefined}>{e.data.navLabel}</a></li>
              ))}
            </ul>
          </div>
        </li>
        {primary.slice(2).map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/inquire" class="btn header-cta" data-track="cta_click" data-track-location="header"><InquireLabel /></a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="when-closed"><Icon name="list" /></span>
      <span class="when-open"><Icon name="x" /></span>
      <span class="visually-hidden">Menu</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav class="container" aria-label="Mobile">
      <ul class="mm-primary">
        <li><a href="/" aria-current={norm === '/' ? 'page' : undefined}>Home</a></li>
        {primary.slice(0, 2).map((l) => <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
        <li><a href="/private-events" aria-current={eventsCurrent}>Private Events</a></li>
        {primary.slice(2).map((l) => <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
      <ul class="mm-events">
        {events.map((e) => <li><a href={`/${e.data.slug}`} aria-current={onEvent(e.data.slug) ? 'page' : undefined}>{e.data.navLabel}</a></li>)}
      </ul>
      <a href="/inquire" class="btn" data-track="cta_click" data-track-location="mobile_menu"><InquireLabel /></a>
    </nav>
  </div>
</header>

<script>
  import { onPage } from '../../lib/lifecycle';

  onPage(() => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]')!;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.documentElement.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    };
    document.addEventListener('keydown', onKey);

    // Solid header once the hero has scrolled away (observer, no scroll listener).
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:0;height:80px;width:1px;pointer-events:none;';
    document.body.prepend(sentinel);
    const io = new IntersectionObserver(([en]) => header.classList.toggle('scrolled', !en.isIntersecting));
    io.observe(sentinel);

    return () => {
      setOpen(false); // never carry an open menu (or a locked scroll) to the next page
      document.removeEventListener('keydown', onKey);
      io.disconnect();
    };
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: background 0.4s var(--ease-out), border-color 0.4s var(--ease-out);
  }
  .site-header.overlay {
    position: fixed;
    inset: 0 0 auto 0;
    background: linear-gradient(rgb(9 8 7 / 0.55), transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
  }
  .site-header.overlay.scrolled,
  .site-header.menu-open {
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-color: var(--line);
  }
  /* backdrop-filter makes the header the containing block for the fixed
     mobile menu, clipping it to the header bar. Solid background while open. */
  .site-header.menu-open { backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--bg); }
  @media (prefers-reduced-transparency: reduce) {
    .site-header, .site-header.overlay.scrolled { background: var(--bg); backdrop-filter: none; }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav { margin-left: auto; }
  .nav > ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.8rem;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .nav a:hover, .nav a[aria-current] { color: var(--text); }
  .nav a[aria-current] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.35em; text-decoration-thickness: 1px; }

  .has-menu { position: relative; }
  .menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 15rem;
    padding: 0.5rem 0;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s var(--ease-out), visibility 0.2s;
  }
  .has-menu:hover .menu,
  .has-menu:focus-within .menu { opacity: 1; visibility: visible; transform: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a { display: flex; width: 100%; padding-inline: 1.1rem; }

  .header-cta { min-height: 42px; }

  .menu-toggle {
    display: none;
    margin-left: auto;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--text);
    cursor: pointer;
  }
  .menu-toggle :global(svg) { width: 22px; height: 22px; }
  .when-open { display: none; }
  .menu-open .when-open { display: inline; }
  .menu-open .when-closed { display: none; }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: var(--z-menu);
    background: var(--bg);
    overflow-y: auto;
    padding-block: 2rem 3rem;
  }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mm-primary a {
    display: block;
    padding-block: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    text-decoration: none;
  }
  .mm-events {
    margin-block: 1.5rem 2rem !important;
    padding-top: 1.25rem !important;
    border-top: 1px solid var(--line);
  }
  .mobile-menu a[aria-current] { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 0.3em; text-decoration-thickness: 1px; }
  .mm-events a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
    text-decoration: none;
  }

  @media (max-width: 1023px) {
    .nav, .header-cta { display: none; }
    .menu-toggle { display: inline-flex; }
  }
</style>
