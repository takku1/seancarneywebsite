---
/**
 * A featured film, on YouTube (click to load). By default The SCE Experience,
 * the brand film (Home, Watch); a page can feature another, e.g. The SCENE live
 * on /the-scene, so pages don't repeat the same video.
 */
import YouTubeFacade from '../media/YouTubeFacade.astro';
import { SCE_EXPERIENCE } from '../../lib/media/experience';
interface Props {
  location?: string;
  film?: { youtubeId: string; title: string };
  heading?: string;
  intro?: string;
  caption?: string;
}
const {
  location = 'home',
  film = SCE_EXPERIENCE,
  heading = 'From a single guitar<br />to a room on its feet.',
  intro = 'Sean, The SCENE, and the people they play for. Watch The SCE Experience.',
  caption = 'Solo, duo and full band · Sean Carney Entertainment',
} = Astro.props;
---
<section class="section supplied-film" data-section="featured_film" data-film={film.youtubeId} aria-labelledby={`live-film-${location}`}>
  <div class="container">
    <div class="head"><h2 id={`live-film-${location}`} set:html={heading} /><p>{intro}</p></div>
    <YouTubeFacade id={film.youtubeId} title={film.title} location={location} large />
    <p class="caption">{caption}</p>
  </div>
</section>
<style>
  .head { display: grid; grid-template-columns: 3fr 2fr; gap: 2rem 4rem; align-items: end; margin-bottom: 2.5rem; }
  h2 { font-size: var(--step-4); line-height: 1.05; }
  .head p { color: var(--text-muted); max-width: 35ch; }
  .caption { font-size: var(--step--1); margin-top: 1rem; color: var(--text-muted); }
  @media(max-width: 767px) { .head { grid-template-columns: minmax(0,1fr); } }
</style>
