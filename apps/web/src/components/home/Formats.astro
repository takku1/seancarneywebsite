---
/** The three formats, from a single guitar to the full band. */
import { Image } from 'astro:assets';
import solo from '../../assets/photos/suit-hands-guitar.jpg';
import trio from '../../assets/photos/event-acoustic-garden.jpg';
import band from '../../assets/photos/wedding-first-dance.jpg';

const formats = [
  { name: 'Solo', when: 'Ceremonies, cocktail hours, dinners and intimate estates.', body: 'Voice and acoustic guitar. The most-requested format, and the quietest luxury in the room.', img: solo, alt: 'Close view of Sean Carney in a dark suit playing an acoustic guitar' },
  { name: 'Duo or trio', when: 'Cocktail hours, welcome dinners and mid-size receptions.', body: 'Added harmony and rhythm, still quiet enough to talk over.', img: trio, alt: 'Sean Carney performing with an acoustic guitar at a garden event' },
  { name: 'Sean Carney and The Hustlers', when: 'Receptions, dance floors and galas.', body: 'The full band, for the part of the night everyone remembers.', img: band, alt: "A couple's first dance under string lights while Sean Carney and the band perform" },
];
---

<section class="section formats" data-section="formats" aria-labelledby="formats-title">
  <div class="container">
    <h2 id="formats-title">Three formats, one house</h2>
    <ul>
      {formats.map((f) => (
        <li>
          <Image src={f.img} alt={f.alt} widths={[480, 800, 1100]} sizes="(min-width: 900px) 30vw, 92vw" />
          <h3>{f.name}</h3>
          <p class="when">{f.when}</p>
          <p class="body">{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .formats { background: var(--bg-raised); border-block: 1px solid var(--line); }
  h2 { font-size: var(--step-4); line-height: 1.02; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  li :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  h3 { margin-top: 1.25rem; font-size: var(--step-2); line-height: 1.1; }
  .when { margin-top: 0.5rem; font-size: var(--step--1); color: var(--accent); }
  .body { margin-top: 0.75rem; color: var(--text-muted); max-width: 38ch; }
  @media (max-width: 899px) { ul { grid-template-columns: minmax(0, 1fr); } li :global(img) { aspect-ratio: 3 / 2; } }
</style>
