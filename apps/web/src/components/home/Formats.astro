---
/** The three formats, from a single guitar to the full band. */
import { Image } from 'astro:assets';
import { photoFor } from '../../lib/media/library';
const solo=photoFor('home.format.solo');
const trio=photoFor('home.format.duo');
const band=photoFor('home.format.band');

const formats = [
  { name: 'Solo', when: 'Ceremonies, cocktail hours, dinners and intimate estates.', body: 'Voice and acoustic guitar. A personal arrangement, with room for every word.', img: solo.image, alt: solo.alt },
  { name: 'Duo', when: 'Cocktail hours, welcome dinners and intimate receptions.', body: 'A second voice, another texture. An intimate set with a little more movement.', img: trio.image, alt: trio.alt },
  { name: 'Band', when: 'Receptions, dance floors and galas.', body: 'The Scene, brought together for the songs that get your people on their feet.', img: band.image, alt: band.alt },
];
---

<section class="section formats" data-section="formats" aria-labelledby="formats-title">
  <div class="container">
    <h2 id="formats-title">Customize your experience</h2>
    <ul>
      {formats.map((f) => (
        <li>
          <Image src={f.img} alt={f.alt} widths={[480, 800, 1100]} sizes="(min-width: 900px) 30vw, 92vw" />
          <h3>{f.name}</h3>
          <p class="when">{f.when}</p>
          <p class="body">{f.body}</p>
          <a class="format-link link-arrow" href={f.name === 'Solo' ? '/repertoire#listen' : f.name === 'Duo' ? '/the-scene#melody-ebner' : '/the-scene'}>{f.name === 'Solo' ? 'Hear the acoustic recordings' : f.name === 'Duo' ? 'Meet the voices' : 'Explore our players'}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .formats { background: var(--bg-raised); border-block: 1px solid var(--line); }
  h2 { font-size: var(--step-4); line-height: 1.02; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  li :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  h3 { margin-top: 1.25rem; font-size: var(--step-2); line-height: 1.1; }
  .when { margin-top: 0.5rem; font-size: var(--step--1); color: var(--accent); }
  .body { margin-top: 0.75rem; color: var(--text-muted); max-width: 38ch; }
  .format-link { margin-top: 1.25rem; }
  @media (max-width: 899px) { ul { grid-template-columns: minmax(0, 1fr); } li :global(img) { aspect-ratio: 3 / 2; } }
</style>
