---
/**
 * Full-bleed hero. The poster <img> is the LCP element (preloaded, high
 * priority). The compressed loop only loads after first paint, never under
 * reduced-motion or Save-Data, and has a visible pause control (WCAG 2.2.2).
 */
import { Image } from 'astro:assets';
import { photoFor, heroSources } from '../../lib/media/library';
const {image:poster,alt:posterAlt}=photoFor('home.hero.poster');
const sources=heroSources();
import Icon from '../ui/Icon.astro';
import { SCE_EXPERIENCE } from '../../lib/media/experience';
const reel = { video: { title: SCE_EXPERIENCE.title, note: 'Solo, duo and full band' } };
import InquireLabel from '../ui/InquireLabel.astro';
---

<section class="hero" data-section="hero" aria-labelledby="hero-title">
  <div class="media">
    <Image
      src={poster}
      alt={posterAlt}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="poster"
    />
    <video class="loop" muted loop playsinline preload="none" aria-hidden="true" data-hero-video>
      <!-- Phones get the 640px edit; larger screens get the 720p edit. -->
      {sources.map(s=><source data-src={s.src} type={s.type} data-size={s.size} />)}
    </video>
    <div class="scrim"></div>
  </div>

  <div class="container content">
    <h1 id="hero-title">Your story. Your song. Anywhere in the world.</h1>
    <p class="sub">Luxury live music for weddings, private celebrations, and corporate events.</p>
    <p class="formats" aria-label="Formats">Solo <span aria-hidden="true">·</span> Duo <span aria-hidden="true">·</span> Band <span aria-hidden="true">·</span> <a href="/custom-song">Custom Written Songs</a></p>
    <div class="ctas">
      <a href="/inquire" class="btn" data-track="cta_click" data-track-location="hero"><InquireLabel /></a>
      {reel && (
        <button type="button" class="watch" data-reel-open data-track="watch_live_click" data-track-location="hero"><Icon name="play" /> Watch The SCE Experience</button>
      )}
    </div>
  </div>

  <button type="button" class="video-toggle" aria-pressed="false" hidden data-hero-toggle>
    <span class="t-pause"><Icon name="pause" /><span class="visually-hidden">Pause background video</span></span>
    <span class="t-play"><Icon name="play" /><span class="visually-hidden">Play background video</span></span>
  </button>
</section>

{reel && (
  <dialog class="reel" aria-label={`${reel.video.title}, video`} data-reel data-yt={SCE_EXPERIENCE.youtubeId}>
    <button type="button" class="reel-x" data-reel-close aria-label="Close video"><Icon name="x" /></button>
    <div class="reel-frame" data-reel-frame></div>
    <p class="reel-cap">{reel.video.title}{reel.video.note && <span>{reel.video.note}</span>}</p>
  </dialog>
)}

<script>
  import { track } from '../../lib/analytics/track';
  import { onPage } from '../../lib/lifecycle';
  import { pause as pausePlayer } from '../../lib/media/player';
  import { embedUrl } from '../../lib/media/yt-player';

  onPage(() => {
    // ---------- The SCE Experience lightbox (YouTube, without leaving home) ----------
    const reelDlg = document.querySelector<HTMLDialogElement>('[data-reel]');
    const reelFrame = reelDlg?.querySelector<HTMLElement>('[data-reel-frame]');
    document.querySelector('[data-reel-open]')?.addEventListener('click', () => {
      if (!reelDlg || !reelFrame) return;
      const frame = document.createElement('iframe');
      frame.src = embedUrl(reelDlg.dataset.yt!);
      frame.title = 'The SCE Experience';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      reelFrame.replaceChildren(frame);
      reelDlg.showModal();
      pausePlayer(); // one thing playing at a time
      document.querySelector<HTMLVideoElement>('[data-hero-video]')?.pause();
      track('video_play', { video_id: reelDlg.dataset.yt!, location: 'hero_lightbox' });
    });
    const closeReel = () => {
      if (!reelDlg) return;
      reelDlg.close();
      reelFrame?.replaceChildren(); // removing the iframe stops playback
    };
    reelDlg?.querySelector('[data-reel-close]')?.addEventListener('click', closeReel);
    reelDlg?.addEventListener('click', (e) => { if (e.target === reelDlg) closeReel(); });
    reelDlg?.addEventListener('cancel', (e) => { e.preventDefault(); closeReel(); });

    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    if (video && toggle && !reduce && !saveData) {
      const start = () => {
        // Pick the file sized for this screen (the <source media> hint isn't reliable for video).
        const size = matchMedia('(max-width: 767px)').matches ? 'sm' : 'lg';
        video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
          if (s.dataset.size !== size) s.remove();
          else s.src = s.dataset.src!;
        });
        video.load();
        video.play().then(
          () => {
            video.classList.add('is-playing');
            toggle.hidden = false;
          },
          () => {
            /* autoplay blocked (e.g. low-power mode): poster stays */
          },
        );
      };
      // Full load: after window load so the reel never competes with LCP. Client navigation: the page is already loaded.
      if (document.readyState === 'complete') setTimeout(start, 300);
      else addEventListener('load', () => setTimeout(start, 300), { once: true });

      toggle.addEventListener('click', () => {
        const paused = toggle.getAttribute('aria-pressed') === 'true';
        if (paused) void video.play();
        else video.pause();
        toggle.setAttribute('aria-pressed', String(!paused));
        track('hero_video_toggle', { state: paused ? 'play' : 'pause' });
      });
    }
    return () => closeReel();
  }, '[data-hero-video], [data-reel-open]');
</script>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .media { position: absolute; inset: 0; z-index: -1; }
  .media :global(.poster), .loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 62% 40%;
  }
  .loop { opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .loop.is-playing { opacity: 1; }
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(9 8 7 / 0.92) 0%, rgb(9 8 7 / 0.55) 35%, rgb(9 8 7 / 0.1) 65%),
      linear-gradient(to right, rgb(9 8 7 / 0.55), transparent 55%);
  }

  /* Text over the film stays light, whatever the page palette. */
  .content {
    --text: var(--on-image);
    --text-muted: var(--on-image-muted);
    --line-strong: rgb(241 235 224 / 0.45);
    color: var(--text);
    padding-block: 0 clamp(3rem, 8vh, 6rem);
  }
  h1 {
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.02em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .sub {
    margin-top: 1.5rem;
    max-width: 36ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .formats {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .formats span { margin-inline: 0.5em; }
  .formats a { color: inherit; text-decoration-color: var(--line-strong); text-underline-offset: 0.25em; }
  .formats a:hover { color: var(--text); }
  .watch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-out);
  }
  .watch:hover { border-color: var(--text); }
  .watch :global(svg) { width: 1em; height: 1em; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 2.25rem; }

  /* Entrance: the promise first, then the line, the formats, the actions. */
  @media (prefers-reduced-motion: no-preference) {
    h1, .sub, .formats, .ctas { animation: enter 0.9s var(--ease-out) both; }
    h1 { animation-delay: 0.2s; animation-duration: 1.1s; }
    .sub { animation-delay: 0.45s; }
    .formats { animation-delay: 0.6s; }
    .ctas { animation-delay: 0.75s; }
    .scrim { animation: dim 1.2s ease both; }
  }
  /* A focus pull from an already-visible start: text paints on the first frame (so it counts
     for LCP immediately), then sharpens into place. Starting at opacity 0 delayed LCP ~0.7s. */
  @keyframes enter { from { opacity: 0.35; transform: translateY(14px); filter: blur(6px); } }
  @keyframes dim { from { opacity: 0.6; } }

  /* Watch live lightbox */
  .reel { width: min(1200px, 94vw); max-width: none; padding: 0; margin: auto; background: #000; border: 0; color: var(--on-image); overflow: visible; }
  .reel::backdrop { background: rgb(5 4 3 / 0.88); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .reel-frame { aspect-ratio: 16 / 9; }
  .reel-frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .reel-x { position: absolute; top: -52px; right: 0; width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 1px solid rgb(241 235 224 / 0.35); color: var(--on-image); cursor: pointer; }
  .reel-x :global(svg) { width: 20px; height: 20px; }
  .reel-cap { position: absolute; left: 0; bottom: -40px; font-family: var(--font-display); font-size: 1.2rem; }
  .reel-cap span { margin-left: 0.75rem; font-family: var(--font-body); font-size: 0.85rem; opacity: 0.7; }
  @media (prefers-reduced-motion: no-preference) {
    .reel[open] { animation: enter 0.45s var(--ease-out); }
  }

  .video-toggle {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-h) + 1rem); /* top-right: bottom-right belongs to the Scout pick */
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: rgb(13 12 11 / 0.5);
    border: 1px solid var(--line-strong);
    color: var(--text);
    cursor: pointer;
  }
  .video-toggle :global(svg) { width: 18px; height: 18px; }
  .t-play { display: none; }
  .video-toggle[aria-pressed='true'] .t-play { display: inline; }
  .video-toggle[aria-pressed='true'] .t-pause { display: none; }

  @media (max-width: 767px) {
    .media :global(.poster), .loop { object-position: 68% 30%; }

  }
</style>
