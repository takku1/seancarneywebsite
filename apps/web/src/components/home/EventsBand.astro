---
/** The conversion band: status above, booking below. */
import { Image } from 'astro:assets';
import bg from '../../assets/photos/event-acoustic-garden.jpg';
import { eventTypes } from '../../lib/content';
import { site } from '../../config/site';
import Icon from '../ui/Icon.astro';
import InquireLabel from '../ui/InquireLabel.astro';

const events = await eventTypes();
---

<section class="band" data-section="events_band" aria-labelledby="band-title">
  <Image src={bg} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="bg" />
  <div class="shade"></div>
  <div class="container inner">
    <div class="copy">
      <p class="label">Private events</p>
      <h2 id="band-title">{site.bookingSeason}</h2>
      <p class="lede">Weddings, galas, company evenings and private estates. Solo, trio, or with his band, The Hustlers.</p>
      <a href="/inquire" class="btn" data-track="cta_click" data-track-location="events_band"><InquireLabel /> <Icon name="arrow-right" /></a>
    </div>
    <ul class="types">
      {events.map((e) => (
        <li>
          <a href={`/${e.data.slug}`} data-track="event_type_click" data-track-event_type={e.data.slug} data-track-location="home_band">
            <span>{e.data.label}</span>
            <Icon name="arrow-right" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(6rem, 12vw, 11rem);
  }
  .band :global(.bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(9 8 7 / 0.94) 0%, rgb(9 8 7 / 0.78) 50%, rgb(9 8 7 / 0.55) 100%);
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: end;
  }
  h2 { font-size: var(--step-4); margin-block: 1rem 1.5rem; max-width: 18ch; }
  .lede { margin-bottom: 2.25rem; color: var(--text); opacity: 0.85; }
  .types { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .types a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-size: var(--step-2);
    text-decoration: none;
    transition: color 0.25s, padding 0.35s var(--ease-out);
  }
  .types a:hover { color: var(--accent); padding-left: 0.5rem; }
  .types :global(svg) { width: 22px; height: 22px; }

  @media (max-width: 899px) {
    .inner { grid-template-columns: minmax(0, 1fr); }
    .shade { background: rgb(9 8 7 / 0.82); }
  }
</style>
