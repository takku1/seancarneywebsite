---
import { Image } from 'astro:assets';
import photo from '../../assets/photos/live-stage.jpg';
import { creditsBy } from '../../lib/content';
import { site } from '../../config/site';

const venues = await creditsBy('venue');
---

<section class="section stages" data-section="stages" aria-labelledby="stages-title">
  <div class="container grid">
    <div class="photo reveal">
      <Image src={photo} alt="Sean Carney on stage with guitar under blue and purple lights" widths={[480, 800, 1003]} sizes="(min-width: 900px) 38vw, 92vw" />
    </div>
    <div>
      <h2 id="stages-title">Stages and rooms</h2>
      <dl class="stats">
        <div><dt>Years performing</dt><dd>{site.stats.years}</dd></div>
        <div><dt>Events</dt><dd>{site.stats.events}</dd></div>
        <div><dt>Countries</dt><dd>{site.stats.countries}</dd></div>
      </dl>
      <h3 class="sub">Venues played</h3>
      <p class="names">{venues.map((v) => v.data.name).join(', ')}.</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .photo :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  h2 { font-size: var(--step-4); margin-bottom: 2.5rem; }
  .stats { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 1rem 3.5rem; margin: 0 0 3rem; }
  .stats div { display: flex; flex-direction: column-reverse; }
  dt { font-size: var(--step--1); color: var(--text-muted); }
  dd { margin: 0; font-family: var(--font-display); font-size: var(--step-4); line-height: 1; color: var(--accent); }
  .sub { font-family: var(--font-body); font-size: var(--step--1); font-weight: 500; color: var(--text-muted); margin: 1.75rem 0 0.5rem; }
  .names { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.25; max-width: 30ch; }

  @media (max-width: 899px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .photo { max-width: 26rem; }
    .stats { gap: 1rem 2rem; }
  }
</style>
