---
/**
 * Follow on Spotify / Subscribe on YouTube. These are the off-site actions
 * that bring a fan back without an ad: new releases reach Spotify followers
 * through Release Radar, uploads reach YouTube subscribers' feeds.
 * Emits follow_click { network, location }.
 */
import Icon from './Icon.astro';
import { site } from '../../config/site';

interface Props { location: string; compact?: boolean }
const { location, compact = false } = Astro.props;
const items = [
  { network: 'spotify', icon: 'spotify' as const, label: 'Follow on Spotify', note: 'New releases land in your Release Radar', href: site.follow.spotify },
  { network: 'youtube', icon: 'youtube' as const, label: 'Subscribe on YouTube', note: 'Live sessions and new videos in your feed', href: site.follow.youtube },
];
---

<ul class:list={['follow', { compact }]} aria-label="Follow Sean">
  {items.map((it) => (
    <li>
      <a href={it.href} target="_blank" rel="noopener" data-track="follow_click" data-track-network={it.network} data-track-location={location}>
        <Icon name={it.icon} />
        <span class="tx"><span class="l">{it.label}</span>{!compact && <span class="n">{it.note}</span>}</span>
        <Icon name="arrow-up-right" />
      </a>
    </li>
  ))}
</ul>

<style>
  .follow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 0.75rem; }
  .follow a { display: flex; align-items: center; gap: 0.9rem; min-height: 64px; padding: 0.75rem 1rem; border: 1px solid var(--line-strong); text-decoration: none; transition: border-color 0.25s var(--ease-out); }
  .follow a:hover { border-color: var(--accent); }
  .follow a > :global(svg:first-child) { flex: none; width: 24px; height: 24px; color: var(--text-muted); }
  .follow a > :global(svg:last-child) { flex: none; width: 16px; height: 16px; margin-left: auto; color: var(--text-muted); }
  .follow a:hover > :global(svg) { color: var(--accent); }
  .tx { display: grid; gap: 0.1rem; }
  .l { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.15; }
  .n { font-size: var(--step--1); color: var(--text-muted); }
  .compact a { min-height: 52px; }
  .compact .l { font-size: var(--step-0); white-space: nowrap; }
</style>
