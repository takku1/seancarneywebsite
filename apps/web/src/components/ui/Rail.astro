---
/**
 * Streaming-style horizontal rail. Native scroll-snap (swipe on touch, trackpad
 * on desktop) plus previous/next buttons that page by one view width and hide
 * at the ends. Children are the items; each becomes a snap point.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  id: string;
}
const { title, id } = Astro.props;
---

<section class="rail" aria-labelledby={`rail-${id}`} data-rail data-section={`rail_${id}`}>
  <div class="rail-head">
    <h3 id={`rail-${id}`}>{title}</h3>
    <div class="rail-nav">
      <button type="button" class="rail-btn" data-dir="-1" aria-label={`Previous in ${title}`} disabled><Icon name="caret-left" /></button>
      <button type="button" class="rail-btn next" data-dir="1" aria-label={`Next in ${title}`}><Icon name="caret-left" /></button>
    </div>
  </div>
  <div class="rail-track" data-rail-track tabindex="0" role="region" aria-label={title}>
    <slot />
  </div>
</section>

<script>
  import { track } from '../../lib/analytics/track';
  import { onPage } from '../../lib/lifecycle';

  onPage(() => {
    const observers: ResizeObserver[] = [];
    document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
      const track_ = rail.querySelector<HTMLElement>('[data-rail-track]')!;
      const [prev, next] = rail.querySelectorAll<HTMLButtonElement>('.rail-btn');
      const sync = () => {
        prev.disabled = track_.scrollLeft < 8;
        next.disabled = track_.scrollLeft + track_.clientWidth >= track_.scrollWidth - 8;
        rail.classList.toggle('static', prev.disabled && next.disabled);
      };
      rail.querySelectorAll<HTMLButtonElement>('.rail-btn').forEach((b) =>
        b.addEventListener('click', () => {
          track_.scrollBy({ left: Number(b.dataset.dir) * track_.clientWidth * 0.85, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          track('rail_scroll', { rail: rail.dataset.section, dir: b.dataset.dir });
        }),
      );
      track_.addEventListener('scrollend', sync);
      track_.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
      const ro = new ResizeObserver(sync);
      ro.observe(track_);
      observers.push(ro);
    });
    return () => observers.forEach((o) => o.disconnect());
  });
</script>

<style>
  .rail + .rail { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .rail-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; }
  h3 { font-family: var(--font-body); font-size: var(--step--1); font-weight: 500; color: var(--text-muted); letter-spacing: 0.02em; }
  .rail-nav { display: flex; gap: 0.4rem; }
  .rail.static .rail-nav { visibility: hidden; }
  .rail-btn { width: 40px; height: 40px; display: grid; place-items: center; background: none; border: 1px solid var(--line-strong); color: var(--text); cursor: pointer; transition: border-color 0.2s, opacity 0.2s; }
  .rail-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .rail-btn:disabled { opacity: 0.3; cursor: default; }
  .rail-btn :global(svg) { width: 18px; height: 18px; }
  .rail-btn.next :global(svg) { transform: scaleX(-1); }
  .rail-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82%, 24rem);
    gap: 1.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    padding-bottom: 0.75rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .rail-track > :global(*) { scroll-snap-align: start; }
  .rail-track:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (hover: none) { .rail-nav { display: none; } }
</style>
