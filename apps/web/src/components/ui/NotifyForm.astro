---
/**
 * Fan-list signup. Posts to /api/notify, which tags the contact in GoHighLevel
 * (fan, notify:<topic>, city:<slug>).
 *  - shows / merch: "tell me when" lists on those pages
 *  - news: the main fan list (new music first), in the footer, on release pages,
 *    /links and the engagement prompt
 * tone="image" sits on photography; tone="surface" follows the page theme.
 */
interface Props {
  topic: 'shows' | 'merch' | 'news';
  /** Ask for a city (shows only): tells Sean where demand is. */
  askCity?: boolean;
  cta?: string;
  tone?: 'image' | 'surface';
  /** Analytics dimension: where this form sits. */
  location?: string;
  /** Unique suffix when the same topic appears twice on one page. */
  idSuffix?: string;
}
const { topic, askCity = false, cta = 'Notify me', tone = 'image', location = topic, idSuffix = location } = Astro.props;
const id = `notify-${topic}-${idSuffix}`;
const fine = topic === 'news' ? 'New releases and the occasional show. No spam, unsubscribe anytime.' : "One email when there's news. No spam, unsubscribe anytime.";
---

<form class:list={['notify', `tone-${tone}`]} data-notify data-topic={topic} data-location={location} data-clarity-mask="true" novalidate>
  <div class="fields">
    <div class="f">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" />
    </div>
    {askCity && (
      <div class="f">
        <label for={`${id}-city`}>Your city <span class="opt">(optional)</span></label>
        <input id={`${id}-city`} name="city" type="text" autocomplete="address-level2" placeholder="e.g. Austin" />
      </div>
    )}
    <button type="submit" class="btn">{cta}</button>
  </div>
  <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <p class="fine">{fine} <a href="/privacy">Privacy</a></p>
  <p class="msg" data-notify-msg role="status" aria-live="polite" hidden></p>
</form>

<script>
  import { track, adsAllowed, newEventId } from '../../lib/analytics/track';
  import { getAttribution } from '../../lib/analytics/attribution';
  import { setItem } from '../../lib/storage';
  import { onPage, bindOnce } from '../../lib/lifecycle';

  onPage(() => {
    const DONE: Record<string, string> = {
      shows: "You're on the list. You'll hear about new dates first.",
      merch: "You're on the list. You'll be first to know when merch drops.",
      news: "You're in. New music lands in your inbox first.",
    };

    document.querySelectorAll<HTMLFormElement>('[data-notify]').forEach((form) => {
      if (!bindOnce(form)) return; // persisted forms (the fan prompt) are already live
      const started = Date.now();
      const msg = form.querySelector<HTMLElement>('[data-notify-msg]')!;
      const topic = form.dataset.topic!;
      const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      let focused = false;
      input.addEventListener('focus', () => {
        if (focused) return;
        focused = true;
        track('notify_start', { topic, location: form.dataset.location });
      });
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const email = String(fd.get('email') || '').trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          msg.textContent = 'That email looks incomplete. Check it and try again.';
          msg.hidden = false;
          input.setAttribute('aria-invalid', 'true');
          input.focus();
          return;
        }
        input.removeAttribute('aria-invalid');
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        const eventId = newEventId();
        try {
          const res = await fetch('/api/notify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ topic, email, city: String(fd.get('city') || ''), website: String(fd.get('website') || ''), started_at: started, page: location.pathname, attribution: getAttribution(), event_id: eventId || undefined, ads_ok: adsAllowed() }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.classList.add('done');
          msg.textContent = DONE[topic] ?? DONE.news;
          msg.hidden = false;
          setItem('fan_joined', '1', 'local'); // stops the engagement prompt from asking again
          track('notify_signup', { topic, location: form.dataset.location, has_city: !!fd.get('city'), event_id: eventId || undefined });
          form.dispatchEvent(new CustomEvent('sc:joined', { bubbles: true }));
        } catch {
          msg.textContent = "That didn't go through. Please try again in a moment.";
          msg.hidden = false;
          btn.disabled = false;
        } finally {
          btn.removeAttribute('aria-busy');
        }
      });
    });
  });
</script>

<style>
  .notify { max-width: 40rem; --_label: var(--on-image-muted); --_field: rgb(9 8 7 / 0.55); --_field-line: rgb(241 235 224 / 0.3); --_ink: var(--on-image); --_ph: rgb(241 235 224 / 0.6); }
  .tone-surface { --_label: var(--text-muted); --_field: var(--bg-raised); --_field-line: var(--line-strong); --_ink: var(--text); --_ph: var(--text-faint); }
  .fields { display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem; }
  .f { display: grid; gap: 0.4rem; flex: 1 1 13rem; }
  label { font-size: var(--step--1); color: var(--_label); }
  .opt { opacity: 0.8; }
  input { min-height: 50px; padding: 0 0.9rem; background: var(--_field); border: 1px solid var(--_field-line); color: var(--_ink); font: inherit; border-radius: 0; caret-color: var(--accent); }
  input::placeholder { color: var(--_ph); }
  input:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
  input[aria-invalid='true'] { border-color: var(--danger); }
  .btn { min-height: 50px; }
  .btn[disabled] { opacity: 0.6; cursor: progress; }
  .fine { margin-top: 0.75rem; font-size: 0.78rem; color: var(--_label); }
  .fine a { color: inherit; }
  .msg { margin-top: 0.75rem; color: var(--_ink); font-family: var(--font-display); font-size: var(--step-1); }
  .done .fields, .done .fine { display: none; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
