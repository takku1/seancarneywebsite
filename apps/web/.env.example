# ─────────────────────────────────────────────────────────────────────────────
# Sean Carney site: environment variables
#
# Local dev:   copy to apps/web/.env  (gitignored). Leave a key blank to disable
#              that integration; the site still runs and logs what it would send.
# Production:  PUBLIC_* are build-time vars (Cloudflare Workers Builds > Variables).
#              Everything else is a secret:  npx wrangler secret put NAME
# Full setup walkthrough: docs/current/04-integrations-and-workflows.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Analytics (public) ───────────────────────────────────────────────────────
# Plausible: cookieless source of truth. Value = your site domain in Plausible.
PUBLIC_PLAUSIBLE_DOMAIN=
# Microsoft Clarity: heatmaps + session replay (inputs masked). Project ID.
PUBLIC_CLARITY_ID=
# Only when running paid ads. GA4 measurement ID (G-XXXX) and Meta Pixel ID.
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# ── Spam protection: Cloudflare Turnstile ────────────────────────────────────
# REQUIRED in production: without the secret, /api/inquire rejects every
# submission (fail closed) and logs turnstile_secret_missing. Optional in dev.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Logging ──────────────────────────────────────────────────────────────────
# Recommended: HMAC key for pseudonymous client keys in security logs
# (openssl rand -hex 32). Without it each Worker instance uses a random key.
LOG_HASH_KEY=

# ── CRM: GoHighLevel (system of record) ──────────────────────────────────────
# Preferred: API v2 via Private Integration (Sub-account > Settings > Private
# Integrations). Scopes: contacts.readonly/write, opportunities.readonly/write.
# Token is shown once; store it immediately.
GHL_PRIVATE_TOKEN=
# Sub-account (location) ID: Settings > Business Profile, or the URL /location/<id>/
GHL_LOCATION_ID=
# Pipeline "Bookings" and its first stage "New inquiry" (Opportunities > Pipelines)
GHL_PIPELINE_ID=
GHL_STAGE_NEW_ID=
# Fallback only: Workflow trigger "Inbound Webhook" URL (premium action in GHL)
GHL_WEBHOOK_URL=

# ── Availability: Google Calendar (free/busy only) ───────────────────────────
# Service account from Google Cloud (Calendar API enabled). Share each calendar
# with GOOGLE_SA_EMAIL as "See only free/busy (hide details)".
GOOGLE_SA_EMAIL=
# The private_key from the JSON key file. Keep the \n escapes on one line.
GOOGLE_SA_PRIVATE_KEY=
# Comma-separated calendar IDs (Calendar settings > Integrate calendar)
GOOGLE_CALENDAR_IDS=
AVAILABILITY_TIMEZONE=America/Los_Angeles

# ── Discovery calls ──────────────────────────────────────────────────────────
# GHL calendar booking link (synced to Google Calendar), shown as "Prefer to talk?"
PUBLIC_CALL_BOOKING_URL=

# ── Email: Resend ────────────────────────────────────────────────────────────
# Verify the sending domain (SPF, DKIM, DMARC records) before going live.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL="Sean Carney <bookings@YOUR-VERIFIED-DOMAIN>"
INQUIRY_NOTIFY_EMAIL=you@YOUR-DOMAIN

# ── Media pipeline (BUILD-time: set as Workers Builds variables) ─────────────
# Ranks wedding and live films and Instagram posts (newest, most watched, best for events).
# Only live performances and covers are shown; original-music uploads are left out.
# Rules, pins and excludes: src/data/feed-rules.json. Rebuild daily to refresh.
# YouTube Data API v3 key (Google Cloud > Credentials > API key, restrict to YouTube Data API)
YOUTUBE_API_KEY=
# Instagram API with Instagram Login for @seancarneyentertainment, long-lived token (60 days; refresh monthly)
INSTAGRAM_ACCESS_TOKEN=

# ── Scout, the AI concierge ──────────────────────────────────────────────────
# No AI backend = guided mode (scripted, free). Governance: docs/current/05-scout-concierge.md
PUBLIC_SCOUT_ENABLED=true
# Backend: anthropic (more adapters can be added in src/lib/scout/providers)
SCOUT_PROVIDER=
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
SCOUT_MODEL=
# REQUIRED in production when AI is on: signs chat transcripts (openssl rand -hex 32).
# Without it, production Scout runs guided mode only (no AI) and logs scout_signing_key_missing.
SCOUT_SIGNING_KEY=
# Max AI turns per day before falling back to guided mode. A soft cap (KV is not
# atomic); set the hard spend limit on the API key's workspace in the Claude Console.
SCOUT_DAILY_LIMIT=1500
# Bearer token for the admin endpoints: GET /api/scout/insights (top questions,
# gaps, hot dates) and GET/POST /api/leads (leads waiting for the CRM; retry)
SCOUT_ADMIN_TOKEN=
# Storage for demand signals: bind a KV namespace named SCOUT_KV in wrangler.jsonc

# ── Ads, server-side (phase 2, when paid campaigns start) ────────────────────
# Meta Conversions API token (Events Manager > Settings). Uses PUBLIC_META_PIXEL_ID.
META_CAPI_ACCESS_TOKEN=
# Google Ads: booked-revenue uploads now go through Google's Data Manager API
# (Ads API offline/EC-for-leads uploads were blocked from 2026-06-15). Configure
# in GHL or a scheduled Worker; not wired yet.
