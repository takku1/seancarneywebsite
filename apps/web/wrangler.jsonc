// Merged by @astrojs/cloudflare into the generated Worker config at build.
{
  "name": "seancarneymusic",
  "compatibility_date": "2026-11-01",
  // Astro's handler plus a cron handler for lead-delivery retries.
  "main": "src/worker.ts",
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  // Anonymous Scout signals (topic counts, date demand). No id: wrangler provisions it on first deploy.
  "kv_namespaces": [{ "binding": "SCOUT_KV" }],
  // Inquiry receipts (90 days), idempotency and the retry queue; see src/lib/inquiry/deliver.ts.
  // D1 rather than KV: strongly consistent with atomic inserts. No id: provisioned on first deploy;
  // the table is created on first use.
  "d1_databases": [{ "binding": "LEADS_DB", "database_name": "seancarneymusic-leads" }],
  // Cloudflare Rate Limiting bindings (periods must be 10 or 60 s). Keys are per route + hashed client.
  // These numbers are the production limits; they must equal src/lib/security/rate-tiers.ts
  // (evals/config-guards.test.mjs checks). src/middleware.ts assigns each route a tier.
  "ratelimits": [
    { "name": "RATE_LIMITER_STRICT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ]
}
