{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > ../../docs/security/sbom.cdx.json",
    "eval:scout": "node evals/run-scout-evals.mjs",
    "verify": "astro check && astro build && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.4.4",
    "simple-icons": "^16.36.0",
    "svg-path-bbox": "^2.1.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
